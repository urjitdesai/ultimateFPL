{
  "name": "@ultimate-fpl/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=env/prod.env dist/server.js",
    "start:local": "node --env-file=env/local.env dist/server.js",
    "start:dev": "node --env-file=env/dev.env dist/server.js",
    "job:sync-score": "tsx src/jobs/sync-score.ts",
    "job:sync-score:dev": "node --env-file=env/dev.env --import=tsx src/jobs/sync-score.ts",
    "job:sync-score:prod": "node --env-file-if-exists=env/prod.env dist/jobs/sync-score.js",
    "job:sync-score:built": "node dist/jobs/sync-score.js",
    "sync:team-logos": "tsx scripts/download-team-logos.ts",
    "purge": "tsx scripts/purge-development-data.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.2",
    "firebase-admin": "^13.5.0",
    "helmet": "^8.3.0",
    "resend": "^6.25.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.2",
    "@types/supertest": "^6.0.3",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
