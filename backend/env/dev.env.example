FIREBASE_STORAGE_BUCKET=
FIREBASE_APP_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account-key.json

ACTIVE_SEASON_ID=
BACKEND_API=https://footballdata.io/api/v1
BACKEND_API_TOKEN=
