{
  "hosting": {
    "site": "predictions-premierleague",
    "public": "frontend/dist",
    "predeploy": [
      "node scripts/validate-frontend-env.mjs production",
      "npm --prefix frontend run build:production"
    ],
    "ignore": [
      "firebase.prod.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
