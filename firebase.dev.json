{
  "hosting": {
    "site": "ultimatefpl-cffba",
    "public": "frontend/dist",
    "predeploy": [
      "node scripts/validate-frontend-env.mjs development",
      "npm --prefix frontend run build:development"
    ],
    "ignore": [
      "firebase.dev.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
