NODE_ENV=production
PORT=4000
FRONTEND_URL=https://YOUR_SITE_ID.web.app
FRONTEND_API_BASE_URL=https://YOUR_CLOUD_RUN_SERVICE_URL/api/v1
TRUST_PROXY_HOPS=1
REQUEST_BODY_LIMIT=32kb
REQUEST_TIMEOUT_MS=60000
HEADERS_TIMEOUT_MS=15000
SERVER_TIMEOUT_MS=65000

FIREBASE_API_KEY=REPLACE_WITH_FIREBASE_WEB_API_KEY
FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
FIREBASE_DATABASE_ID=(default)
FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
FIREBASE_APP_ID=REPLACE_WITH_FIREBASE_WEB_APP_ID

# Cloud Run uses Application Default Credentials. Do not add a downloaded
# service-account key or private key to production configuration.
BACKEND_API=https://footballdata.io/api/v1
BACKEND_API_TOKEN=INJECT_FROM_SECRET_MANAGER
FOOTBALLDATA_IO_LEAGUE_ID=15
FOOTBALLDATA_IO_SEASON_YEAR=20262027

RATE_LIMIT_WINDOW_MS=60000
PROFILE_RATE_LIMIT=10
LEAGUE_CREATE_RATE_LIMIT=10
LEAGUE_JOIN_RATE_LIMIT=20
GAMEWEEK_SUBMISSION_RATE_LIMIT=30
STANDINGS_READ_RATE_LIMIT=60
PROVIDER_BACKED_READ_RATE_LIMIT=120
MAX_CREATED_LEAGUES_PER_USER=50
MAX_PRIVATE_LEAGUE_MEMBERS=100

SCORING_MODE=scheduled
SCORING_JOB_ENABLED=false
SCORING_EXPECTED_PROJECT_ID=
SCORING_BATCH_SIZE=200
SCORING_LEASE_MS=1200000
SCORING_RUN_RETENTION_DAYS=30
SYNC_LIVE_INTERVAL_MS=300000
SYNC_RECENT_INTERVAL_MS=1800000
SYNC_IDLE_INTERVAL_MS=86400000

PURGE_ALLOWED_PROJECT_IDS=
PURGE_PROTECTED_PROJECT_IDS=YOUR_PROJECT_ID
